{
	"chapter.3A8EED1650FCCF98.title": "Incarnam"
	"chapter.3A8EED1650FCCF98.chapter_subtitle": [
		"Le tutoriel d'Arceus"
	]
	"quest.00EBEFDB07F860D2.title": "Réveil"
	"quest.00EBEFDB07F860D2.quest_subtitle": "Arceus t'a rendu la vie"
	"quest.00EBEFDB07F860D2.quest_desc": [
		"Tu ouvres les yeux sur une île perdue dans les nuages."
		"Une voix immense résonne : « Je suis Arceus. Les humains avaient disparu, je t'ai recréé ici, à Incarnam. »"
		"« Prouve que les humains et les Pokémon peuvent de nouveau vivre ensemble. »"
		"Parle à Arceus sur la place, puis valide."
	]
